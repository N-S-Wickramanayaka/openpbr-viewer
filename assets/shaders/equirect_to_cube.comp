#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uPanorama;
layout(binding = 0, rgba16f) writeonly uniform imageCube uCubemap;

#include "ibl_common.glsl"

// One invocation per cube map texel: find its direction, look that direction up in the panorama.
void main()
{
    int size = imageSize(uCubemap).x;
    ivec3 id = ivec3(gl_GlobalInvocationID);   // x, y = texel, z = face
    if (id.x >= size || id.y >= size) return;

    vec3 direction = cubeTexelDirection(id.z, id.xy, size);
    vec3 radiance = textureLod(uPanorama, directionToEquirectUV(direction), 0.0).rgb;
    imageStore(uCubemap, id, vec4(min(radiance, vec3(65000.0)), 1.0));   // stay inside the 16-bit float range
}